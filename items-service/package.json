{
  "name": "digital-sippoy-items-service",
  "version": "1.0.0",
  "private": true,
  "description": "Digital-Sippoy items-service: standalone Node/Express service owning data/items.json, called by the web gateway over HTTP. Built once, uniformly, across all 16 Microservices-labelled branches.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "lint:report": "eslint . --ext .ts -f json -o lint-report.json",
    "dup": "jscpd . --config jscpd.json",
    "test": "mocha",
    "test:coverage": "nyc npm test",
    "test:coverage:gate": "nyc --check-coverage --statements 95 --functions 95 --lines 95 --branches 85 npm test"
  },
  "dependencies": {
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9",
    "eslint-plugin-security": "^3.0.1",
    "jscpd": "^4.0.5",
    "mocha": "^10.7.3",
    "nyc": "^17.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}
